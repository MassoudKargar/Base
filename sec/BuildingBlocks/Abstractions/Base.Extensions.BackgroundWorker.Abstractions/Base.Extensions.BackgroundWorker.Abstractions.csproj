<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>10.0.0</Version>
		<Authors>Masoud kargar</Authors>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<RepositoryUrl>https://github.com/MassoudKargar/Base</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>base.png</PackageIcon>
		<RootNamespace>$(MSBuildProjectName.Replace(".Abstractions","").Replace(" ", "_"))</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<None Include="../../../../README.md" Pack="true" PackagePath="" />
		<None Include="../../../../base.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
	</ItemGroup>


  <!-- Keep legacy Extension contracts in the single canonical package. -->
  <ItemGroup>
    <Compile Include="..\..\..\..\Extentsions\Base.Extensions.Abstractions\Base.Extensions.BackgroundWorker.Abstractions\**\*.cs" Exclude="..\..\..\..\Extentsions\Base.Extensions.Abstractions\Base.Extensions.BackgroundWorker.Abstractions\**\obj\**;..\..\..\..\Extentsions\Base.Extensions.Abstractions\Base.Extensions.BackgroundWorker.Abstractions\**\bin\**" Link="Compatibility\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
